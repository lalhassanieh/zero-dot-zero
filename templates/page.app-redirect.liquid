{% layout none %}
{%- comment -%}
  ============================================================================
  SMART APP DOWNLOAD / REDIRECT PAGE - standalone (recommended)
  ----------------------------------------------------------------------------
  No header, no footer, none of the theme's CSS or JS. The page is a single
  self-contained document, so the redirect fires in roughly 100ms instead of
  waiting on ~38 theme assets.

  Want the normal header and footer instead? Set the page's theme template to
  "app-redirect-full". Same settings, same buttons, just slower to redirect.

  SETUP - no code editing required
    1. Online Store > Pages > Add page   (e.g. title "Get the App")
    2. Theme template  ->  select "app-redirect"
    3. Customize > Theme settings > App download page
       -> paste the store links, pick the logo, colours and button layout.
    4. Share  https://your-store.com/pages/<handle>  on social, or point your
       QR code at it.

  The theme editor never auto-redirects, so you can safely style the page
  in the customizer.

  TEST / DEBUG URLS
    ?noredirect=1   show the fallback page without redirecting
    ?to=ios         force a target (also: android, desktop)
    ?qr=1           printable QR code of this page

  TRACKING
    Any ?src= / ?utm_source= / ?utm_medium= / ?utm_campaign= on the incoming
    link is forwarded to the store: Google Play gets a `referrer` value,
    the App Store gets a `ct` campaign token. The built-in QR uses ?src=qr.
  ============================================================================
{%- endcomment -%}

{%- assign meta_bg = settings.app_page_bg | default: '#ffffff' -%}

{%- assign meta_logo = '' -%}
{%- if settings.app_logo != blank -%}
  {%- assign meta_logo = settings.app_logo | image_url: width: 1200 -%}
{%- elsif shop.brand.logo != blank -%}
  {%- assign meta_logo = shop.brand.logo | image_url: width: 1200 -%}
{%- endif -%}

{%- assign lang = request.locale.iso_code | slice: 0, 2 -%}
{%- if lang == 'ar' -%}
  {%- assign page_dir  = 'rtl' -%}
  {%- assign meta_title = 'حمّل التطبيق' -%}
  {%- assign meta_desc  = 'اختر متجرك لتنزيل التطبيق' -%}
{%- else -%}
  {%- assign page_dir  = 'ltr' -%}
  {%- assign meta_title = 'Get the app' -%}
  {%- assign meta_desc  = 'Choose your store to download' -%}
{%- endif -%}
{%- if page.title != blank -%}{%- assign meta_title = page.title -%}{%- endif -%}
{%- if page.content != blank -%}{%- assign meta_desc = page.content | strip_html | strip -%}{%- endif -%}

<!doctype html>
<html lang="{{ request.locale.iso_code }}" dir="{{ page_dir }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="robots" content="noindex, follow">
  <meta name="theme-color" content="{{ meta_bg }}">
  <title>{{ meta_title }} · {{ shop.name }}</title>
  <meta name="description" content="{{ meta_desc | escape }}">
  <link rel="canonical" href="{{ canonical_url }}">

  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ shop.name | escape }}">
  <meta property="og:title" content="{{ meta_title | escape }}">
  <meta property="og:description" content="{{ meta_desc | escape }}">
  <meta property="og:url" content="{{ canonical_url }}">
  {%- if meta_logo != blank %}
  <meta property="og:image" content="{{ meta_logo }}">
  {%- endif %}
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ meta_title | escape }}">
  <meta name="twitter:description" content="{{ meta_desc | escape }}">
  {%- if meta_logo != blank %}
  <meta name="twitter:image" content="{{ meta_logo }}">
  {%- endif %}
</head>

<body>
  {% render 'app-redirect', standalone: true %}
</body>
</html>
