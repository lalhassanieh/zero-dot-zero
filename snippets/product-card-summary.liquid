{%- liquid
    if product.metafields.custom.short_description != blank
        assign desc = product.metafields.custom.short_description | strip_html
        assign word_number = 100000
    elsif product.metafields.c_f.short_description != blank
        assign desc = product.metafields.c_f.short_description | strip_html
        assign word_number = 100000
    else
        assign desc = product.description | strip_html
        assign word_number = 44
    endif
-%}
<div class="card-summary {{ class }}">{{ desc | truncatewords: word_number }}</div>