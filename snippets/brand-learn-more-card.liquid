{%- comment -%}
  Renders one card in the brand "learn more" cards grid.
  Accepts: image, title, button_label, link
{%- endcomment -%}
<div class="brand-learn-cards__item">
    <a class="brand-learn-cards__link" {% if link == blank %}role="link" aria-disabled="true"{% else %}href="{{ link }}"{% endif %}>
        <div class="brand-learn-cards__image adaptive_height" style="padding-top: {% if image != blank %}{{ 1 | divided_by: image.aspect_ratio | times: 100 }}%{% else %}100%{% endif %}">
            {%- if image != blank -%}
                <img srcset="{{ image | image_url: width: 375 }} 375w, {{ image | image_url: width: 750 }} 750w, {{ image | image_url: width: 1100 }} 1100w" src="{{ image | image_url: width: 750 }}" alt="{{ title | escape }}" width="{{ image.width }}" height="{{ image.height }}" loading="lazy">
            {%- else -%}
                <div class="placeholder" style="--height_placeholder: 400px;">{{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
            {%- endif -%}
        </div>
        <div class="brand-learn-cards__overlay"></div>
        <div class="brand-learn-cards__content">
            {%- if title != blank -%}<h3 class="brand-learn-cards__title">{{ title }}</h3>{%- endif -%}
            {%- if button_label != blank -%}<span class="brand-learn-cards__button">{{ button_label }}</span>{%- endif -%}
        </div>
    </a>
</div>
