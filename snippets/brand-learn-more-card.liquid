{%- comment -%}
  Renders one card in the brand "learn more" cards grid.
  Accepts: image, title, button_label, card_collection, link, scroll_target, enable_overlay,
  title_color, button_text_color, button_text_color_hover, button_bg_color, button_bg_color_hover

  Where the card links to, highest priority first:
    1. card_collection - a Collection; the card goes to that collection's page.
    2. scroll_target   - a section ID on this same page; scrolls there instead of navigating away.
    3. link            - any URL.
  All three blank renders a non-clickable card, same as before. It is named card_collection,
  not collection, so it cannot shadow the global collection object on a collection template.

  "enable_overlay" (default on) darkens the whole image at a low opacity so text stays legible
  even over a bright/white photo. It's fully configurable/removable via the section settings
  (color, gradient, or turned off entirely).

  title_color/button_text_color/button_bg_color/button_bg_color_hover (all optional) override
  this one card's colors by re-declaring the section's CSS custom properties on just this item -
  leave any of them blank to fall back to the section-wide color.
{%- endcomment -%}
{%- liquid
    if card_collection != blank
        assign final_link = card_collection.url
    elsif scroll_target != blank
        assign final_link = '#shopify-section-' | append: scroll_target
    else
        assign final_link = link
    endif

    assign card_style = ''
    if title_color != blank
        assign card_style = card_style | append: '--brand-learn-cards-title-color: ' | append: title_color | append: ';'
    endif
    if button_text_color != blank
        assign card_style = card_style | append: '--brand-learn-cards-button-color: ' | append: button_text_color | append: ';'
    endif
    if button_bg_color != blank
        assign card_style = card_style | append: '--brand-learn-cards-button-bg: ' | append: button_bg_color | append: ';'
    endif
    if button_text_color_hover != blank
        assign card_style = card_style | append: '--brand-learn-cards-button-color-hover: ' | append: button_text_color_hover | append: ';'
    endif
    if button_bg_color_hover != blank
        assign card_style = card_style | append: '--brand-learn-cards-button-bg-hover: ' | append: button_bg_color_hover | append: ';'
    endif
-%}
<div class="brand-learn-cards__item"{% if card_style != blank %} style="{{ card_style }}"{% endif %}>
    <a class="brand-learn-cards__link" {% if final_link == blank %}role="link" aria-disabled="true"{% else %}href="{{ final_link }}"{% endif %}>
        <div class="brand-learn-cards__image">
            {%- if image != blank -%}
                <img srcset="{{ image | image_url: width: 375 }} 375w, {{ image | image_url: width: 750 }} 750w, {{ image | image_url: width: 1100 }} 1100w" src="{{ image | image_url: width: 750 }}" alt="{{ title | escape }}" width="{{ image.width }}" height="{{ image.height }}" loading="lazy">
            {%- else -%}
                <div class="brand-learn-cards__image-placeholder"><span></span></div>
            {%- endif -%}
        </div>
        {%- if enable_overlay -%}
            <div class="brand-learn-cards__overlay"><span></span></div>
        {%- endif -%}
        {%- if title != blank -%}
            <div class="brand-learn-cards__title-wrap">
                <h3 class="brand-learn-cards__title">{{ title }}</h3>
            </div>
        {%- endif -%}
        {%- if button_label != blank -%}
            <div class="brand-learn-cards__button-wrap">
                <span class="brand-learn-cards__button">
                    <span>{{ button_label }}</span>
                    <svg class="brand-learn-cards__button-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M13.5 4.5 12.44 5.56 18.13 11.25H4v1.5h14.13l-5.69 5.69 1.06 1.06L21 12Z"></path></svg>
                </span>
            </div>
        {%- endif -%}
    </a>
</div>
