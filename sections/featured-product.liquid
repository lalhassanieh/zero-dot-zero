<style type="text/css">
  #ProductSection-{{ section.id }} {
      background: {{ bg_color_product }};
  }

  #ProductSection-{{ section.id }} .halo-block-header .title {
      color: {{ color_title }};
      font-size: {{ fontsize_title | append: 'px'  }};
      margin-bottom: {{ margin_bottom_title | append: 'px' }};
      line-height: {{ fontsize_title | append: 'px'  }};
  }

  #ProductSection-{{ section.id }} .halo-block-header .title:before {
      display: none;
  }

  #ProductSection-{{ section.id }} .halo-block-header .title .text {
      background-color: transparent;
  }

  #ProductSection-{{ section.id }} .halo-block-header .rte {
      font-size: {{ fontsize_des | append: 'px' }};
      color: {{ color_des }};
      margin-bottom: {{ margin_bottom_des | append: 'px'  }};
  }

  #ProductSection-{{ section.id }} .productView-thumbnail .productView-thumbnail-link:after{
      padding-bottom: {{ portrait_aspect_ratio }};
  }

  #ProductSection-{{ section.id }} .productView-thumbnail.slick-current .productView-thumbnail-link {
      border-bottom: 2px solid {{ thumbnail_active_color }};
  }

  #ProductSection-{{ section.id }} .productView-thumbnail-wrapper .slick-arrow svg {
      color: {{ thumbnail_arrow_color_mb }};
      fill: {{ thumbnail_arrow_color_mb }};
  }

  #ProductSection-{{ section.id }} .productView-img-container .media {
      background: {{ main_image_bg_color }};
  }

  #ProductSection-{{ section.id }} .productView-thumbnail .productView-thumbnail-link {
      background: {{ thumbnail_image_bg_color }};
  }

  {%- if section.settings.main_image_column_width > 0 and section.settings.main_image_column_width != 50 -%}
  {%- assign right_col_width = 100 | minus: section.settings.main_image_column_width -%}
  @media (min-width: 1025px) {
      #ProductSection-{{ section.id }} .productView-top .halo-productView-left {
          width: {{ section.settings.main_image_column_width }}% !important;
      }
      #ProductSection-{{ section.id }} .productView-top .halo-productView-right {
          width: {{ right_col_width }}% !important;
      }
  }
  {%- endif -%}

  {%- assign fp_lang = request.locale.iso_code | slice: 0, 2 -%}
  {%- if fp_lang == 'ar' -%}
  @media (min-width: 1025px) {
      #ProductSection-{{ section.id }} .productView-top {
          flex-direction: row-reverse;
      }
  }
  @media (min-width: 1200px) {
      #ProductSection-{{ section.id }} .productView-top .halo-productView-right {
          padding-left: 0 !important;
          padding-right: {{ section.settings.right_column_padding }}px !important;
      }
  }
  {%- else -%}
  @media (min-width: 1200px) {
      #ProductSection-{{ section.id }} .productView-top .halo-productView-right {
          padding-left: {{ section.settings.right_column_padding }}px;
      }
  }
  {%- endif -%}

  @media (min-width: 768px) {
      #ProductSection-{{ section.id }} .productView-top .halo-productView-left {
          padding-left: 0 !important;
          padding-right: 0 !important;
      }
  }

  @media (max-width: 1024px) {
      #ProductSection-{{ section.id }} .halo-block-header .title {
          font-size: {{ fontsize_title_mb | append: 'px'  }};
          margin-bottom: {{ margin_bottom_title_mb | append: 'px'  }};
      }
  }

  @media (max-width: 767px) {
      #ProductSection-{{ section.id }} {
          padding-top: {{ mg_top_mobile | append: 'px' }};
          padding-bottom: {{ mg_bottom_mobile | append: 'px' }};
      }

      #ProductSection-{{ section.id }} .halo-block-header .rte {
          margin-bottom: {{ margin_bottom_des_mb | append: 'px'  }};
      }
  }

  @media (min-width: 1025px) {
      {% if container == 'fullwidth' %}
          #ProductSection-{{ section.id }} > .container-full {
              padding-left: {{ padding_full_width | append: 'px' }};
              padding-right: {{ padding_full_width | append: 'px' }};
          }
      {% endif %}
  }

  @media (min-width: 768px) and (max-width: 1199px) {
      #ProductSection-{{ section.id }} {
          padding-top: {{ mg_top_tablet | append: 'px' }};
          padding-bottom: {{ mg_bottom_tablet | append: 'px' }};
      }
  }

  @media (min-width: 1200px) {
      #ProductSection-{{ section.id }} {
          padding-top: {{ mg_top_desktop | append: 'px' }};
          padding-bottom: {{ mg_bottom_desktop | append: 'px' }};
      }
  }
</style>

<script>
  {%- for fp_h in fp_handles -%}
    {%- assign fp_p = all_products[fp_h] -%}
    window.product_inven_array_{{ fp_p.id }} = {
        {% for variant in fp_p.variants %}'{{ variant.id }}': '{{ variant.inventory_quantity }}',{% endfor %}
    };
    window.selling_array_{{ fp_p.id }} = {
        {% for variant in fp_p.variants %}'{{ variant.id }}': '{{ variant.inventory_policy }}',{% endfor %}
    };
  {%- endfor -%}

  window.subtotal = {
      show: false
  };

  {% if show_variant_image_group %}
      window.variant_image_group = {{ show_variant_image_group }};
  {% else %}
      window.variant_image_group = 'false';
  {% endif %}
</script>

