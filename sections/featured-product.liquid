{%- liquid
  # Build the list of product handles to show in the slider.
  # Priority: the SINGLE metafield (related_product) wins when it is set, showing just that product.
  # If the single one is empty, use the LIST metafield (related_products) to show a multi-product slider.
  # Falls back to the manually picked featured_product when both are empty.
  assign fp_handles = '' | split: ','
  if section.settings.use_article_metafield
    assign mf_ns = section.settings.metafield_namespace | default: 'custom'
    assign mf_single = article.metafields[mf_ns][section.settings.metafield_key]
    assign mf_list = article.metafields[mf_ns][section.settings.metafield_key_multiple]

    assign mf_active = null
    if mf_single != blank and mf_single.value != blank
      assign mf_active = mf_single
    elsif mf_list != blank and mf_list.value != blank
      assign mf_active = mf_list
    endif

    if mf_active != blank
      assign fp_str = ''
      if mf_active.type contains 'list'
        for mf_p in mf_active.value
          if mf_p.handle != blank
            assign fp_str = fp_str | append: mf_p.handle | append: ','
          endif
        endfor
      else
        assign fp_str = mf_active.value.handle | append: ','
      endif
      assign fp_handles = fp_str | split: ','
    endif
  endif
  if fp_handles.size == 0 and section.settings.featured_product != blank
    assign fp_handles = section.settings.featured_product.handle | append: ',' | split: ','
  endif
  assign product = all_products[fp_handles.first]
  assign bg_color_product = section.settings.bg_color_product
  assign color_title = section.settings.color_title
  assign fontsize_title = section.settings.fontsize_title
  assign fontsize_title_mb = section.settings.fontsize_title_mb
  assign margin_bottom_title = section.settings.margin_bottom_title
  assign margin_bottom_title_mb = section.settings.margin_bottom_title_mb
  assign color_des = section.settings.color_des
  assign fontsize_des = section.settings.fontsize_des
  assign margin_bottom_des = section.settings.margin_bottom_des
  assign margin_bottom_des_mb = section.settings.margin_bottom_des_mb
  assign thumbnail_active_color = section.settings.thumbnail_active_color
  assign thumbnail_arrow_color_mb = section.settings.thumbnail_arrow_color_mb

  assign container = section.settings.container
  assign padding_full_width = section.settings.padding_full_width
  assign show_sticky_info = section.settings.show_sticky_info
  assign mg_top_desktop = section.settings.mg_top_desktop
  assign mg_top_tablet = section.settings.mg_top_tablet
  assign mg_top_mobile = section.settings.mg_top_mobile
  assign mg_bottom_desktop = section.settings.mg_bottom_desktop
  assign mg_bottom_tablet = section.settings.mg_bottom_tablet
  assign mg_bottom_mobile = section.settings.mg_bottom_mobile
  assign main_image_position = section.settings.main_image_position

  assign thumnail_layout = section.settings.thumnail_layout
  assign thumbnail_image_bg_color = section.settings.thumbnail_image_bg_color
  assign main_image_arrows_desktop = section.settings.main_image_arrows_desktop
  assign main_image_counter_mobile = section.settings.main_image_counter_mobile
  assign main_image_bg_color = section.settings.main_image_bg_color
  assign show_thumbnail_mobile = section.settings.show_thumbnail_mobile
  assign max_thumbnail_to_show = section.settings.thumbnail_to_show
  assign current_variant = product.selected_or_first_available_variant
  assign variant_count = product.variants | size
  assign featured_media_aspect_ratio = product.featured_media.aspect_ratio
  if product.featured_media.aspect_ratio == null
    assign featured_media_aspect_ratio = 1
  endif
  assign media_size = section.settings.product_image_ratio
  assign portrait_aspect_ratio = section.settings.portrait_aspect_ratio | append: '%'
  assign media_fit = section.settings.media_fit
  assign product_image_popup = section.settings.product_image_popup
  assign video_layout = section.settings.video_layout
  assign show_badge = section.settings.show_badge
  assign show_hot_stock = settings.show_hot_stock
  if show_hot_stock
    assign product_max_stock = settings.hot_stock_limit | plus: 0
  endif
  assign first_3d_model = product.media | where: 'media_type', 'model' | first

  for block in section.blocks
    case block.type
      when 'quantity_selector'
        assign check_block_qty = true
        assign qty_style = block.settings.qty_style
        assign qty_layout = block.settings.qty_layout
      when 'buy_buttons'
        assign check_block_buttons = true
      when 'variant_picker'
        assign picker_type = block.settings.picker_type
        assign show_variant_image_group = block.settings.show_variant_image_group
    endcase
  endfor
  if check_block_qty
    if check_block_buttons
      if qty_layout == '1'
        assign check_show_qty = 'show_qty_1'
      elsif qty_layout == '2'
        assign check_show_qty = 'show_qty_2'
      endif
    else
      assign check_show_qty = 'show_qty_1'
    endif
  else
    assign check_show_qty = 'show_qty_0'
  endif
-%}

