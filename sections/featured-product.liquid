{%- comment -%} Slider styles + product-switch behavior (arrows / dots / autoplay) {%- endcomment -%}
<style>
  /* Let the switch arrows sit in the outer margin without being clipped. */
  #ProductSection-{{ section.id }} .fp-slider { position: relative; }
  #ProductSection-{{ section.id }} .fp-viewport { position: relative; }
  #ProductSection-{{ section.id }} .fp-live { transition: opacity .3s ease; }
  #ProductSection-{{ section.id }} .fp-slider.is-switching .fp-live { opacity: 0; }

  /* Prevent the "jump": before the gallery slider initializes, keep only the first
     image / thumbnail visible so the injected product doesn't flash as a tall stack. */
  #ProductSection-{{ section.id }} .productView-nav:not(.slick-initialized) > .productView-image:not(:first-child),
  #ProductSection-{{ section.id }} .productView-for:not(.slick-initialized) > .productView-thumbnail:not(:first-child) {
    display: none;
  }

  /* Reserve the image box from its own aspect ratio so an injected (unloaded) image can't
     collapse the slide, and fill that box with the media/img. */
  #ProductSection-{{ section.id }} .fp-reserve .productView-image.fit-unset .productView-img-container {
    padding-bottom: 0 !important;
    height: auto;
  }
  #ProductSection-{{ section.id }} .fp-reserve .productView-image.fit-unset .productView-img-container .media {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }
  #ProductSection-{{ section.id }} .fp-reserve .productView-image.fit-unset .productView-img-container img:not(.zoomImg) {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    max-width: 100%;
    margin: 0;
    transform: none;
    object-fit: contain;
    object-position: center;
  }
  #ProductSection-{{ section.id }} .fp-reserve .productView-nav.image-fit-unset .slick-track {
    align-items: stretch;
  }

  /* Vertically center the details column and its content against the image. */
  @media (min-width: 768px) {
    #ProductSection-{{ section.id }} .productView-top { align-items: stretch; }
    #ProductSection-{{ section.id }} .halo-productView-right {
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
  }

  /* Switch controls sit in one centered row BELOW the product ( â¹  â¢ â¢ â¢  âº ),
     so they never overlap the image's own next/prev arrows. The arrows reuse the
     theme's .slick-arrow styling (box, colors, icon) to match the site's carousels. */
  #ProductSection-{{ section.id }} .fp-controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    margin-top: 24px;
  }
  #ProductSection-{{ section.id }} .fp-nav.slick-arrow {
    position: static;
    top: auto;
    transform: none;
    z-index: 5;
  }

  #ProductSection-{{ section.id }} .fp-dots {
    display: flex;
    gap: 8px;
    justify-content: center;
    align-items: center;
    margin-top: 0;
  }
  #ProductSection-{{ section.id }} .fp-dot {
    width: 7px;
    height: 7px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: rgba(30, 60, 50, .25);
    cursor: pointer;
    transition: background .2s ease, transform .2s ease;
  }
  #ProductSection-{{ section.id }} .fp-dot.is-active { background: #1E3C32; transform: scale(1.25); }
</style>

<script>
  (function () {
    var root = document.getElementById('ProductSection-{{ section.id }}');
    if (!root) return;
    var slider = root.querySelector('[data-fp-slider]');
    if (!slider) return;

    var live = slider.querySelector('[data-fp-live]');
    var viewport = slider.querySelector('[data-fp-viewport]');
    var templates = slider.querySelectorAll('[data-fp-tpl]');
    var dots = slider.querySelectorAll('[data-fp-dot]');
    var prevBtn = slider.querySelector('[data-fp-prev]');
    var nextBtn = slider.querySelector('[data-fp-next]');
    if (!live || templates.length === 0) return;

    // Slide 0 is already live/server-rendered; cache its markup, then collect the rest from templates.
    var slides = [live.innerHTML];
    templates.forEach(function (tpl) { slides.push(tpl.innerHTML); });

    var count = slides.length;
    var index = 0;
    var switching = false;

    var autoplay = slider.getAttribute('data-fp-autoplay') === 'true';
    var speed = parseInt(slider.getAttribute('data-fp-speed'), 10) || 5000;
    var timer = null;

    // Lock the viewport to the TALLEST product so switching never changes the section
    // height (footer stays put). The lock only ever GROWS, never shrinks, so a shorter
    // product can't collapse it and a mis-measured taller one can't be clipped.
    var lockedH = 0;
    function applyLock(h) {
      if (h > lockedH) {
        lockedH = h;
        if (viewport) viewport.style.minHeight = lockedH + 'px';
      }
    }
    function lockHeight() {
      if (!viewport) return;
      var w = viewport.clientWidth;
      if (!w) return;
      var probe = document.createElement('div');
      probe.className = 'fp-live';
      probe.style.cssText = 'position:absolute;left:0;top:0;visibility:hidden;pointer-events:none;z-index:-1;width:' + w + 'px';
      viewport.appendChild(probe);
      var max = 0;
      for (var i = 0; i < slides.length; i++) {
        probe.innerHTML = slides[i];
        if (probe.offsetHeight > max) max = probe.offsetHeight;
      }
      probe.innerHTML = '';
      viewport.removeChild(probe);
      applyLock(max);
      // Also account for the currently-rendered product in case the live layout (after slick
      // init / image load) is taller than the static measurement.
      if (live) applyLock(live.scrollHeight);
    }

    function reinit() {
      // Re-run the theme's product-view init for the freshly injected product.
      if (window.halo && window.jQuery) {
        try {
          var $scope = window.jQuery(live).find('.halo-productView');
          if ($scope.length) window.halo.initProductView($scope);
        } catch (e) {}
      }
    }

    function go(i) {
      if (count <= 1) return;
      var target = ((i % count) + count) % count;
      if (target === index || switching) return;
      switching = true;
      slider.classList.add('is-switching'); // fade the current product out

      // After the fade-out, swap the markup in while it's invisible, then reveal it and
      // initialize the new product's gallery WHILE VISIBLE (slick lays out its image
      // arrows/thumbnails reliably only when the element isn't opacity:0).
      setTimeout(function () {
        index = target;
        live.innerHTML = slides[index];
        dots.forEach(function (d, di) { d.classList.toggle('is-active', di === index); });
        requestAnimationFrame(function () {
          slider.classList.remove('is-switching'); // now visible
          reinit();                                 // init the gallery/variants while visible
          if (window.jQuery) {
            try { window.jQuery(live).find('.productView-nav, .productView-for').slick('setPosition'); } catch (e) {}
          }
          // Nudge slick to (re)draw its arrows/track for the freshly shown product.
          try { window.dispatchEvent(new Event('resize')); } catch (e) {}
          switching = false;
          applyLock(live.scrollHeight); // grow the lock if this product ends up taller than measured
          // The image reserves no height until it loads; re-check after so the lock stays correct.
          setTimeout(function () { applyLock(live.scrollHeight); }, 800);
        });
      }, 300);
    }

    function stop() { if (timer) { clearInterval(timer); timer = null; } }
    function start() { if (autoplay && count > 1) { stop(); timer = setInterval(function () { go(index + 1); }, speed); } }
    function restart() { stop(); start(); }

    if (prevBtn) prevBtn.addEventListener('click', function () { go(index - 1); restart(); });
    if (nextBtn) nextBtn.addEventListener('click', function () { go(index + 1); restart(); });
    dots.forEach(function (d, di) { d.addEventListener('click', function () { go(di); restart(); }); });

    slider.addEventListener('mouseenter', stop);
    slider.addEventListener('mouseleave', start);

    // Lock height after layout settles, again after the gallery slick initializes,
    // after full load (images), and on resize.
    requestAnimationFrame(function () { requestAnimationFrame(lockHeight); });
    setTimeout(lockHeight, 700);
    setTimeout(lockHeight, 1500);
    window.addEventListener('load', lockHeight);
    var resizeT;
    window.addEventListener('resize', function () { clearTimeout(resizeT); resizeT = setTimeout(lockHeight, 250); });

    start();
  })();
</script>

{%- endif -%}

