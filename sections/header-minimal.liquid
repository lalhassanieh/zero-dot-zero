{{ 'component-header-minimal.css' | asset_url | stylesheet_tag }}
<header
  class="header header-minimal"
  style="--spacing-l-r: {{ section.settings.padding_full_width }}px; --bg-color: {% if section.settings.header_bg_gradient != blank %}{{ section.settings.header_bg_gradient }}{% else %}{{ section.settings.header_bg }}{% endif %}; --p-top: {{ section.settings.padding_top }}px; --p-bottom: {{ section.settings.padding_bottom }}px"
>
  <div class="container container-{{ section.settings.container }}">
    <div class="header-minimal__content header-minimal__content-size--{{ section.blocks.size }}">
      {%- for block in section.blocks -%}
        <div class="header-minimal__item">
          {%- case block.type -%}
            {%- when 'group_1' -%}
              <div class="header__social-media" style="--color: {{ block.settings.color }}">
                {% render 'halo-social-media-icons' %}
              </div>
            {%- when 'group_3' -%}
              {%- comment -%}
                Messages come from every "announcement_bar" entry in the homepage content list
                (shop.metafields.custom.homepage_content), so the mobile app gets them with the rest
                of the homepage. It is a shop metafield, so the bar shows on every page, not only home.
                Entries with "enabled" off are skipped. The {riyal} token is swapped for the riyal icon.
                Falls back to the block's text settings if there are no entries, or when
                "Use metaobject content" is off. More than one message turns the bar into a slider.
              {%- endcomment -%}
              {%- capture riyal_icon -%}<span class="price-item price-item--regular"><span class="riyal-font riyal-font--header"></span></span>{%- endcapture -%}
              {%- comment -%} Messages are gathered into one string split by "|||", then each becomes a slide. {%- endcomment -%}
              {%- assign has_meta_entries = false -%}
              {%- assign announcement_messages = '' -%}
              {%- assign homepage_content = shop.metafields.custom.homepage_content.value -%}
              {%- if block.settings.use_metaobject_content and homepage_content != blank and homepage_content.blocks != blank -%}
                {%- for block_item in homepage_content.blocks.value -%}
                  {%- if block_item.system.type == 'announcement_bar' -%}
                    {%- assign has_meta_entries = true -%}
                    {%- if block_item.enabled.value != false and block_item.text != blank -%}
                      {%- assign meta_html = block_item.text | metafield_tag | replace: '<div class="metafield-rich_text_field">', '' | replace: '</div>', '' | replace: '<p>', '' -%}
                      {%- if block.settings.split_lines -%}
                        {%- assign meta_html = meta_html | replace: '</p>', '<br>' -%}
                      {%- else -%}
                        {%- assign meta_html = meta_html | replace: '</p>', ' ' -%}
                      {%- endif -%}
                      {%- assign announcement_messages = announcement_messages | append: '|||' | append: meta_html -%}
                    {%- endif -%}
                  {%- endif -%}
                {%- endfor -%}
              {%- endif -%}
              {%- unless has_meta_entries -%}
                {%- assign announcement_messages = '|||' | append: block.settings.announcement_text | append: '|||' | append: block.settings.announcement_text_2 | append: '|||' | append: block.settings.announcement_text_3 -%}
              {%- endunless -%}
              {%- if block.settings.split_lines -%}
                {%- assign announcement_messages = announcement_messages | replace: '<br />', '|||' | replace: '<br/>', '|||' | replace: '<br>', '|||' -%}
              {%- endif -%}
              {%- capture announcement_slides -%}
                {%- assign announcement_list = announcement_messages | replace: '{riyal}', riyal_icon | split: '|||' -%}
                {%- for message in announcement_list -%}
                  {%- assign message_check = message | replace: '&nbsp;', '' | strip_html | strip -%}
                  {%- if message_check != blank or message contains 'riyal-font' -%}
                    <div class="announcement-text announcement-slider__slide">{{ message | strip }}</div>
                  {%- endif -%}
                {%- endfor -%}
              {%- endcapture -%}
              {%- assign announcement_count = announcement_slides | split: 'announcement-slider__slide' | size | minus: 1 -%}
              {%- if announcement_count > 0 -%}
                <announcement-slider
                  class="announcement-slider{% if announcement_count > 1 %} announcement-slider--multiple{% endif %}"
                  style="color: {{ block.settings.announcement_text_color }}"
                  {% if block.settings.autoplay and announcement_count > 1 %}data-autoplay="{{ block.settings.autoplay_speed | times: 1000 }}"{% endif %}
                >
                  {%- if announcement_count > 1 -%}
                    <div class="announcement-slider__arrows">
                      <button type="button" class="announcement-slider__arrow" data-announcement-prev aria-label="{{ 'accessibility.previous_slide' | t }}">
                        <svg width="6" height="11" viewBox="0 0 6 11" fill="none" aria-hidden="true" focusable="false"><path d="M5.5 1 1 5.5 5.5 10" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
                      </button>
                      <button type="button" class="announcement-slider__arrow" data-announcement-next aria-label="{{ 'accessibility.next_slide' | t }}">
                        <svg width="6" height="11" viewBox="0 0 6 11" fill="none" aria-hidden="true" focusable="false"><path d="m.5 1 4.5 4.5L.5 10" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
                      </button>
                    </div>
                  {%- endif -%}
                  <div class="announcement-slider__viewport" aria-live="polite">
                    {{ announcement_slides }}
                  </div>
                </announcement-slider>
              {%- endif -%}
            {%- when 'group_2' -%}
              <div
                class="header__icons text-right clearfix"
                style="--language-currency-color: {{ block.settings.language_currency_color }}; --language-currency-bg: {{ block.settings.language_currency_bg }}; --cart-color-item: {{ block.settings.cart_color_item }}; --cart-bg-item: {{ block.settings.cart_bg_item }}; --cart-item-font-size: {{ block.settings.cart_item_font_size }}px"
              >
                {%- if block.settings.show_language_currency -%}
                  {%- if settings.enable_multilang_shopify or settings.enable_currencies -%}
                    <div class="header-language_currency{% unless settings.enable_multilang_shopify %} no-language{% endunless %}{% unless settings.enable_currencies %} no-currency{% endunless %}">
                      <div class="top-language-currency">
                        {%- if settings.enable_multilang_shopify -%}
                          {% render 'halo-top-language' %}
                        {%- endif -%}
                        {%- if settings.enable_currencies -%}
                          {% render 'halo-top-currency' %}
                        {%- endif -%}
                      </div>
                    </div>
                  {%- endif -%}
                {%- endif -%}
                {%- if block.settings.show_cart -%}
                  <a
                    {% if settings.show_quick_cart %}
                      data-cart-sidebar role="link" aria-disabled="true"
                    {% else %}
                      href="{{ routes.cart_url }}"
                    {% endif %}
                    class="header__icon header__icon--cart link link--text focus-inset"
                    id="cart-icon-bubble"
                  >
                    {% render 'icon-cart-02' %}
                    <div class="cart-count-bubble">
                      <span class="text" aria-hidden="true" data-cart-count>
                        {%- if cart.item_count < 100 -%}
                          {{ cart.item_count }}
                        {%- else -%}
                          {{ 'sections.cart.item_99' | t }}
                        {%- endif -%}
                      </span>
                      <span class="visually-hidden">
                        {{- 'sections.header.cart_count' | t: count: cart.item_count -}}
                      </span>
                    </div>
                  </a>
                {%- endif -%}
              </div>
          {%- endcase -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</header>

<script>
  if (!customElements.get('announcement-slider')) {
    customElements.define('announcement-slider', class AnnouncementSlider extends HTMLElement {
      connectedCallback() {
        this.slides = Array.from(this.querySelectorAll('.announcement-slider__slide'));
        if (getComputedStyle(this).direction === 'rtl') this.classList.add('is-rtl');
        if (this.slides.length < 2) return;

        this.index = 0;
        this.slides.forEach((slide, i) => this.setHidden(slide, i !== 0));
        this.slides[0].classList.add('is-active');

        this.querySelector('[data-announcement-prev]').addEventListener('click', () => this.go(-1));
        this.querySelector('[data-announcement-next]').addEventListener('click', () => this.go(1));

        this.delay = parseInt(this.dataset.autoplay, 10);
        if (this.delay) {
          ['mouseenter', 'focusin'].forEach((e) => this.addEventListener(e, () => this.stop()));
          ['mouseleave', 'focusout'].forEach((e) => this.addEventListener(e, () => this.start()));
          this.start();
        }
      }

      disconnectedCallback() {
        this.stop();
      }

      setHidden(slide, hidden) {
        slide.setAttribute('aria-hidden', hidden);
        slide.querySelectorAll('a, button').forEach((el) => (hidden ? el.setAttribute('tabindex', '-1') : el.removeAttribute('tabindex')));
      }

      go(step) {
        const current = this.slides[this.index];
        this.index = (this.index + step + this.slides.length) % this.slides.length;
        const next = this.slides[this.index];

        // Park the incoming message on the side it enters from, without animating there.
        this.slides.forEach((slide) => slide.classList.remove('is-leaving'));
        next.style.transition = 'none';
        this.classList.toggle('is-reverse', step < 0);
        void next.offsetHeight;
        next.style.transition = '';

        current.classList.remove('is-active');
        current.classList.add('is-leaving');
        next.classList.add('is-active');
        this.setHidden(current, true);
        this.setHidden(next, false);
      }

      start() {
        this.stop();
        if (this.delay) this.timer = setInterval(() => this.go(1), this.delay);
      }

      stop() {
        clearInterval(this.timer);
      }
    });
  }
</script>

{% schema %}
{
  "name": "Header - Minimal",
  "limit": 1,
  "class": "section-header-minimal",
  "settings": [
    {
      "type": "paragraph",
      "content": "*You should only activate\/use \"Header\" you want, don't use the redundant headers which may not optimize for performance."
    },
    {
      "type": "select",
      "id": "container",
      "label": "t:sections.layout.container.option",
      "default": "1170",
      "options": [
        {
          "value": "1170",
          "label": "t:sections.layout.container.option4"
        },
        {
          "value": "1370",
          "label": "t:sections.layout.container.option8"
        },
        {
          "value": "1470",
          "label": "t:sections.layout.container.option5"
        },
        {
          "value": "1570",
          "label": "t:sections.layout.container.option6"
        },
        {
          "value": "1770",
          "label": "t:sections.layout.container.option3"
        },
        {
          "value": "full",
          "label": "t:sections.layout.container.option2"
        }
      ]
    },
    {
      "type": "range",
      "id": "padding_full_width",
      "label": "t:sections.layout.container.padding_full_width",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "t:sections.layout.fontsize.fontsize_title.unit",
      "default": 0
    },
    {
      "type": "color",
      "id": "header_bg",
      "label": "t:settings_schema.colors.settings.colors_name.background_color_2",
      "default": "#26292d"
    },
    {
      "type": "color_background",
      "id": "header_bg_gradient",
      "label": "t:settings_schema.colors.settings.colors_name.background_color_gradient"
    },
    {
      "type": "header",
      "content": "t:sections.main-product.settings.general.spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "label": "t:settings_schema.typography.settings.type_button_font.padding_top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "label": "t:settings_schema.typography.settings.type_button_font.padding_bottom",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "group_1",
      "name": "Social Media",
      "limit": 1,
      "settings": [
        {
          "type": "color",
          "id": "color",
          "label": "t:settings_schema.typography.settings.typography.icon_color",
          "default": "#fff"
        }
      ]
    },
    {
      "type": "group_2",
      "name": "Conversion & Cart",
      "limit": 1,
      "settings": [
        {
          "type": "header",
          "content": "t:sections.header.settings.header_top.language_currency"
        },
        {
          "type": "checkbox",
          "id": "show_language_currency",
          "label": "t:sections.header.settings.navigation.label_3",
          "default": true
        },
        {
          "type": "color",
          "id": "language_currency_color",
          "label": "t:sections.header.settings.header_top.label__4",
          "default": "#323232"
        },
        {
          "type": "color",
          "id": "language_currency_bg",
          "label": "t:settings_schema.colors.settings.colors_name.background_color_2",
          "default": "#DDBDB0"
        },
        {
          "type": "header",
          "content": "t:sections.header.settings.header_top.cart"
        },
        {
          "type": "checkbox",
          "id": "show_cart",
          "label": "t:sections.header.settings.header_icons.label__4",
          "default": true
        },
        {
          "type": "color",
          "id": "cart_color_item",
          "label": "t:sections.header.settings.header_top.color_items_cart",
          "default": "#323232"
        },
        {
          "type": "color",
          "id": "cart_bg_item",
          "label": "t:sections.header.settings.header_top.background_color_items_cart",
          "default": "#DDBDB0"
        },
        {
          "type": "range",
          "id": "cart_item_font_size",
          "label": "t:sections.header.settings.header_top.font_size_cart_item",
          "min": 10,
          "max": 25,
          "step": 1,
          "unit": "t:sections.header.settings.logo.unit",
          "default": 14
        }
      ]
    },
    {
      "type": "group_3",
      "name": "Announcement Text",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "To translate this text into Arabic, use the Translate & Adapt app in the Shopify admin."
        },
        {
          "type": "checkbox",
          "id": "use_metaobject_content",
          "label": "Use metaobject content",
          "default": false,
          "info": "Enable to show the text of the Announcement bar entry (type: announcement_bar) from the homepage content list instead of the text below."
        },
        {
          "type": "html",
          "id": "announcement_text",
          "label": "t:sections.header.settings.header_top.announcement_text",
          "default": "Free Delivery for Orders Above <span class=\"price-item price-item--regular\"><span class=\"riyal-font riyal-font--header\"></span> 300<\/span>"
        },
        {
          "type": "html",
          "id": "announcement_text_2",
          "label": "Announcement text 2",
          "info": "Optional. With more than one message the bar becomes a slider with arrows."
        },
        {
          "type": "html",
          "id": "announcement_text_3",
          "label": "Announcement text 3"
        },
        {
          "type": "color",
          "id": "announcement_text_color",
          "label": "t:sections.header.settings.header_top.announcement_text_color",
          "default": "#fff"
        },
        {
          "type": "header",
          "content": "Slider"
        },
        {
          "type": "checkbox",
          "id": "split_lines",
          "label": "Show each line as its own message",
          "default": true,
          "info": "Each line break in the text becomes a separate slide."
        },
        {
          "type": "checkbox",
          "id": "autoplay",
          "label": "Auto-rotate messages",
          "default": true
        },
        {
          "type": "range",
          "id": "autoplay_speed",
          "label": "Change message every",
          "min": 3,
          "max": 10,
          "step": 1,
          "unit": "s",
          "default": 5
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Header - Minimal",
      "blocks": [
        {
          "type": "group_1"
        },
        {
          "type": "group_2"
        },
        {
          "type": "group_3"
        }
      ]
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  }
}
{% endschema %}
