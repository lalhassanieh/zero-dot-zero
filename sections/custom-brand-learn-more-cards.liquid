{%- comment -%}
  Grid of image cards with a title and a "Learn More" style button, e.g. one card per product
  line (Plastic Bottle / Glass Bottle / Sparkling).

  Cards can come from either this section's own blocks (added directly in the theme editor)
  or from "Learn More Card" metaobject entries (system.type == 'brand_learn_card') in this
  page's shared content list, when "Use metaobject content" is enabled below. All matching
  metaobject entries are rendered, ordered by their "order" field.
{%- endcomment -%}

{%- assign page_content_source = blank -%}
{%- assign all_blocks = blank -%}
{%- assign meta_cards = '' | split: ',' -%}

{%- if template.name == 'index' -%}
    {%- assign page_content_source = shop.metafields.custom.homepage_content.value -%}
{%- elsif page != blank -%}
    {%- assign page_content_source = page.metafields.custom.page_content.value -%}
{%- endif -%}

{%- if page_content_source != blank and page_content_source.blocks != blank -%}
    {%- assign all_blocks = page_content_source.blocks.value -%}
{%- endif -%}

{%- if section.settings.use_metaobject_content and all_blocks != blank -%}
    {%- assign unsorted_cards = '' | split: ',' -%}
    {%- for block_item in all_blocks -%}
        {%- if block_item.system.type == 'brand_learn_card' -%}
            {%- assign unsorted_cards = unsorted_cards | concat: [block_item] -%}
        {%- endif -%}
    {%- endfor -%}
    {%- assign meta_cards = unsorted_cards | sort: 'order' -%}
{%- endif -%}

<div
    class="brand-learn-cards section-block-{{ section.id }}"
    id="brand-learn-cards-{{ section.id }}"
    style="
        --brand-learn-cards-columns: {{ section.settings.columns }};
        --brand-learn-cards-gap: {{ section.settings.item_gap }}px;
        --brand-learn-cards-radius: {{ section.settings.card_border_radius }}px;
        --brand-learn-cards-overlay: {{ section.settings.overlay_color }};
        --brand-learn-cards-title-color: {{ section.settings.title_color }};
        --brand-learn-cards-button-color: {{ section.settings.button_text_color }};
        --brand-learn-cards-button-bg: {{ section.settings.button_bg_color }};
    "
>
    <div class="{% if section.settings.container == '1170' %}container-1170{% elsif section.settings.container == '1470' %}container-1470{% elsif section.settings.container == 'fullwidth' %}container-full{% else %}container{% endif %}">
        {%- if section.settings.heading != blank -%}
            <h2 class="brand-learn-cards__heading text-{{ section.settings.heading_align }}">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- liquid
            assign card_blocks = section.blocks | where: 'type', 'card'
            assign has_cards = false
            if section.settings.use_metaobject_content and meta_cards.size > 0
                assign has_cards = true
            elsif section.settings.use_metaobject_content == false and card_blocks.size > 0
                assign has_cards = true
            endif
        -%}
        <div class="brand-learn-cards__grid">
            {%- if has_cards -%}
                {%- if section.settings.use_metaobject_content -%}
                    {%- for card in meta_cards -%}
                        {%- render 'brand-learn-more-card', image: card.image.value, title: card.title, button_label: card.button_label, link: card.link -%}
                    {%- endfor -%}
                {%- else -%}
                    {%- for block in card_blocks -%}
                        {%- render 'brand-learn-more-card', image: block.settings.image, title: block.settings.title, button_label: block.settings.button_label, link: block.settings.link -%}
                    {%- endfor -%}
                {%- endif -%}
            {%- else -%}
                {%- comment -%} Nothing configured yet - show sample content so the section isn't invisible {%- endcomment -%}
                {%- render 'brand-learn-more-card', title: 'Mineral Water', button_label: 'Learn More' -%}
                {%- render 'brand-learn-more-card', title: 'Sparkling Water', button_label: 'Learn More' -%}
                {%- render 'brand-learn-more-card', title: 'Glass Bottle', button_label: 'Learn More' -%}
            {%- endif -%}
        </div>
    </div>
</div>

{% schema %}
{
    "name": "Brand Learn More Cards",
    "class": "section-brand-learn-cards",
    "settings": [
        {
            "type": "checkbox",
            "id": "use_metaobject_content",
            "label": "Use metaobject content",
            "info": "When enabled, cards come from 'Learn More Card' metaobject entries in this page's content list instead of the blocks below.",
            "default": false
        },
        { "type": "header", "content": "Heading" },
        { "type": "text", "id": "heading", "label": "Heading (optional)" },
        { "type": "select", "id": "heading_align", "label": "Heading alignment", "default": "center", "options": [
            { "value": "left", "label": "Left" },
            { "value": "center", "label": "Center" }
        ]},
        { "type": "header", "content": "Grid" },
        { "type": "select", "id": "container", "label": "Container width", "default": "container", "options": [
            { "value": "container", "label": "Standard" },
            { "value": "1170", "label": "1170px" },
            { "value": "1470", "label": "1470px" },
            { "value": "fullwidth", "label": "Full width" }
        ]},
        { "type": "range", "id": "columns", "label": "Columns (desktop)", "min": 2, "max": 4, "step": 1, "default": 3 },
        { "type": "range", "id": "item_gap", "label": "Gap between cards", "min": 0, "max": 60, "step": 2, "unit": "px", "default": 24 },
        { "type": "range", "id": "card_border_radius", "label": "Card corner radius", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 16 },
        { "type": "color", "id": "overlay_color", "label": "Image overlay color", "default": "#00000066" },
        { "type": "header", "content": "Text & Button" },
        { "type": "color", "id": "title_color", "label": "Card title color", "default": "#ffffff" },
        { "type": "color", "id": "button_text_color", "label": "Button text color", "default": "#0b2545" },
        { "type": "color", "id": "button_bg_color", "label": "Button background", "default": "#ffffff" }
    ],
    "blocks": [
        {
            "type": "card",
            "name": "Card",
            "settings": [
                { "type": "image_picker", "id": "image", "label": "Image" },
                { "type": "text", "id": "title", "label": "Title", "default": "Mineral Water" },
                { "type": "text", "id": "button_label", "label": "Button label", "default": "Learn More" },
                { "type": "url", "id": "link", "label": "Link" }
            ]
        }
    ],
    "presets": [
        {
            "name": "Brand Learn More Cards",
            "blocks": [
                { "type": "card" },
                { "type": "card" },
                { "type": "card" }
            ]
        }
    ]
}
{% endschema %}
