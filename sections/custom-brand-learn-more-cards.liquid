{%- comment -%}
  Grid of image cards with a title and a "Learn More" style button, e.g. one card per product
  line (Plastic Bottle / Glass Bottle / Sparkling).

  Cards can come from either this section's own blocks (added directly in the theme editor)
  or from a single "Learn More Cards Grid" metaobject entry (system.type == 'brand_learn_card_grid')
  in this page's shared content list, when "Use metaobject content" is enabled below. That grid
  entry has one field ("cards") which is an ordered list of references to individual "Learn More
  Card" entries - reorder them by dragging within that list field, not with an "order" field.
{%- endcomment -%}

{%- assign page_content_source = blank -%}
{%- assign all_blocks = blank -%}
{%- assign meta_cards = blank -%}

{%- if template.name == 'index' -%}
    {%- assign page_content_source = shop.metafields.custom.homepage_content.value -%}
{%- elsif page != blank -%}
    {%- assign page_content_source = page.metafields.custom.page_content.value -%}
{%- endif -%}

{%- if page_content_source != blank and page_content_source.blocks != blank -%}
    {%- assign all_blocks = page_content_source.blocks.value -%}
{%- endif -%}

{%- if section.settings.use_metaobject_content and all_blocks != blank -%}
    {%- for block_item in all_blocks -%}
        {%- if block_item.system.type == 'brand_learn_card_grid' -%}
            {%- assign meta_cards = block_item.cards.value -%}
            {%- break -%}
        {%- endif -%}
    {%- endfor -%}
{%- endif -%}

{%- liquid
    assign overlay_background = section.settings.overlay_color
    if section.settings.overlay_gradient != blank
        assign overlay_background = section.settings.overlay_gradient
    endif
-%}

<div
    class="brand-learn-cards section-block-{{ section.id }}"
    id="brand-learn-cards-{{ section.id }}"
    style="
        --brand-learn-cards-columns: {{ section.settings.columns }};
        --brand-learn-cards-columns-mobile: {{ section.settings.columns_mobile }};
        --brand-learn-cards-gap: {{ section.settings.item_gap }}px;
        --brand-learn-cards-gap-mobile: {{ section.settings.item_gap_mobile }}px;
        --brand-learn-cards-radius: {{ section.settings.card_border_radius }}px;
        --brand-learn-cards-overlay: {{ overlay_background }};
        --brand-learn-cards-title-color: {{ section.settings.title_color }};
        --brand-learn-cards-button-color: {{ section.settings.button_text_color }};
        --brand-learn-cards-button-bg: {{ section.settings.button_bg_color }};
        --brand-learn-cards-button-bg-hover: {{ section.settings.button_bg_color_hover }};
        --brand-learn-cards-card-height: {{ section.settings.card_height }}px;
        --brand-learn-cards-card-height-mb: {{ section.settings.card_height_mobile }}px;
        --brand-learn-cards-padding-top: {{ section.settings.padding_top }}px;
        --brand-learn-cards-padding-bottom: {{ section.settings.padding_bottom }}px;
        --brand-learn-cards-bg: {{ section.settings.background_color }};
    "
>
    <div class="{% if section.settings.container == '1170' %}container-1170{% elsif section.settings.container == '1470' %}container-1470{% elsif section.settings.container == 'fullwidth' %}container-full{% else %}container{% endif %}">
        {%- if section.settings.heading != blank -%}
            <h2 class="brand-learn-cards__heading text-{{ section.settings.heading_align }}">{{ section.settings.heading }}</h2>
        {%- endif -%}
        <div class="brand-learn-cards__grid">
            {%- if section.settings.use_metaobject_content -%}
                {%- for card in meta_cards -%}
                    {%- render 'brand-learn-more-card', image: card.image.value, title: card.name, button_label: card.button_label, link: card.link, scroll_target: card.scroll_target, enable_overlay: section.settings.enable_overlay -%}
                {%- endfor -%}
            {%- else -%}
                {%- for block in section.blocks -%}
                    {%- if block.type == 'card' -%}
                        {%- render 'brand-learn-more-card', image: block.settings.image, title: block.settings.title, button_label: block.settings.button_label, link: block.settings.link, scroll_target: block.settings.scroll_target, enable_overlay: section.settings.enable_overlay -%}
                    {%- endif -%}
                {%- endfor -%}
            {%- endif -%}
        </div>
    </div>
</div>

{% schema %}
{
    "name": "Brand Learn More Cards",
    "class": "section-brand-learn-cards",
    "settings": [
        {
            "type": "checkbox",
            "id": "use_metaobject_content",
            "label": "Use metaobject content",
            "info": "When enabled, cards come from the 'cards' list on a 'Learn More Cards Grid' metaobject entry in this page's content list, instead of the blocks below.",
            "default": false
        },
        { "type": "header", "content": "Heading" },
        { "type": "text", "id": "heading", "label": "Heading (optional)" },
        { "type": "select", "id": "heading_align", "label": "Heading alignment", "default": "center", "options": [
            { "value": "left", "label": "Left" },
            { "value": "center", "label": "Center" }
        ]},
        { "type": "header", "content": "Grid" },
        { "type": "color", "id": "background_color", "label": "Section background color", "default": "#FEF7EC" },
        { "type": "select", "id": "container", "label": "Container width", "default": "container", "options": [
            { "value": "container", "label": "Standard" },
            { "value": "1170", "label": "1170px" },
            { "value": "1470", "label": "1470px" },
            { "value": "fullwidth", "label": "Full width" }
        ]},
        { "type": "range", "id": "columns", "label": "Columns (desktop)", "min": 2, "max": 4, "step": 1, "default": 3 },
        { "type": "range", "id": "columns_mobile", "label": "Columns (mobile)", "min": 1, "max": 3, "step": 1, "default": 1 },
        { "type": "range", "id": "item_gap", "label": "Gap between cards (desktop)", "min": 0, "max": 60, "step": 2, "unit": "px", "default": 24 },
        { "type": "range", "id": "item_gap_mobile", "label": "Gap between cards (mobile)", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 16 },
        { "type": "range", "id": "card_border_radius", "label": "Card corner radius", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 16 },
        { "type": "range", "id": "card_height", "label": "Card image height (desktop)", "min": 200, "max": 700, "step": 10, "unit": "px", "default": 520 },
        { "type": "range", "id": "card_height_mobile", "label": "Card image height (mobile)", "min": 200, "max": 600, "step": 10, "unit": "px", "default": 400 },
        {
            "type": "checkbox",
            "id": "enable_overlay",
            "label": "Enable image overlay",
            "info": "A subtle scrim behind the title is always there so it stays readable - this is a separate, stronger top+bottom tint you can turn off if you don't want it.",
            "default": true
        },
        { "type": "color", "id": "overlay_color", "label": "Image overlay color", "default": "#00000040" },
        { "type": "color_background", "id": "overlay_gradient", "label": "Image overlay gradient (optional, overrides color above)" },
        { "type": "header", "content": "Text & Button" },
        { "type": "color", "id": "title_color", "label": "Card title color", "default": "#ffffff" },
        { "type": "color", "id": "button_text_color", "label": "Button text color", "default": "#ffffff" },
        { "type": "color", "id": "button_bg_color", "label": "Button background", "default": "#285BAA" },
        { "type": "color", "id": "button_bg_color_hover", "label": "Button background (hover)", "default": "#204988" },
        { "type": "header", "content": "Spacing" },
        { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 150, "step": 5, "unit": "px", "default": 60 },
        { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 150, "step": 5, "unit": "px", "default": 60 }
    ],
    "blocks": [
        {
            "type": "card",
            "name": "Card",
            "settings": [
                { "type": "image_picker", "id": "image", "label": "Image" },
                { "type": "text", "id": "title", "label": "Title", "default": "Mineral Water" },
                { "type": "text", "id": "button_label", "label": "Button label", "default": "Learn More" },
                {
                    "type": "url",
                    "id": "link",
                    "label": "Link",
                    "info": "The default: sends the visitor to another page/URL. Leave blank if using the section ID option below instead."
                },
                {
                    "type": "text",
                    "id": "scroll_target",
                    "label": "Or scroll to section (ID), instead of the link above",
                    "info": "Optional. If set, overrides Link above and scrolls to that section's ID on this same page instead of navigating away."
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "Brand Learn More Cards",
            "blocks": [
                { "type": "card" },
                { "type": "card" },
                { "type": "card" }
            ]
        }
    ]
}
{% endschema %}
